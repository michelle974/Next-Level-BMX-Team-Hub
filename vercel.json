{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/remind",
      "schedule": "0 12 * * *"
    }
  ],
  "functions": {
    "api/raceday.js": {
      "maxDuration": 30
    }
  }
}
